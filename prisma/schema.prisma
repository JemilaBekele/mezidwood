enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

// Governs how much the scheduler may move a project automatically.
//   AUTO   - cron, completion-cascade and auto-schedule may all move it.
//   MANUAL - automatic jobs skip it; only explicit user actions move it.
//   LOCKED - nothing automatic touches it and an explicit auto-schedule
//            refuses, until it is unlocked (e.g. a customer-confirmed date).
// NOTE: capacity accounting (release on completion/cancel) ALWAYS runs
// regardless of mode — only date movement is gated.
enum ScheduleMode {
  AUTO
  MANUAL
  LOCKED
}

// Audit trail of everything that changes a project's schedule/delivery date.
enum ScheduleEventType {
  CREATED
  RESCHEDULED
  STAGE_COMPLETED
  STAGE_CANCELLED
  PROJECT_CANCELLED
  MANUAL_OVERRIDE
  CAPACITY_RELEASED
  DELIVERY_RECOMPUTED
  MODE_CHANGED
}

// What initiated a schedule event.
enum ScheduleTrigger {
  USER
  CRON
  COMPLETION
  CANCELLATION
  SYSTEM
}

// Business-tunable scheduling knobs. Singleton (app-enforced: always the
// first row). config.js constants are the fallback defaults when no row
// exists. Editing this lets the business change the delivery formula
// (contingency, difficulty %, working hours) without a deploy.
model SchedulingSettings {
  id                 String   @id @default(uuid())
  contingencyDays    Int      @default(3)
  easyPercent        Float    @default(0)
  mediumPercent      Float    @default(0.4)
  hardPercent        Float    @default(0.5)
  workingHoursPerDay Float    @default(7.5)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("scheduling_settings")
}

model ScheduleHistory {
  id          String            @id @default(uuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event       ScheduleEventType
  trigger     ScheduleTrigger
  stage       ProjectStatus?
  oldDelivery DateTime?
  newDelivery DateTime?
  reason      String?           @db.Text
  byUserId    String?           @db.Char(36)
  byUser      User?             @relation(fields: [byUserId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([projectId])
  @@map("schedule_history")
}

enum WorkShift {
  MORNING
  AFTERNOON
  FULL_DAY
  CUSTOM
}

// Capacity-consuming stages only. The full workflow lives in `ProjectStatus`
// (12 stages); INVOICE/PURCHASING/INSTALLATION are intentionally absent here
// because they are scheduled by elapsed time, not by daily factory capacity.
// Keep this list in sync with CAPACITY_STAGES in src/services/scheduling/config.js.
enum CapacityStage {
  DESIGN
  METAL_WORKS
  CNC
  CUTTING
  EDGE_BANDING
  ASSEMBLY
  PAINTING
  FINISHING
  DELIVERY
}

// Working-calendar exceptions. Combined with the weekly working-day set in
// config.js (WORKING_DAYS) this is the single source of truth for which
// calendar days are non-working. `recurring` = repeats yearly on month/day.
model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique
  name      String
  recurring Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("holidays")
}

enum ProjectStatus {
  INVOICE
  DESIGN
  PURCHASING
  METAL_WORKS
  CNC
  CUTTING
  EDGE_BANDING
  ASSEMBLY
  PAINTING
  FINISHING
  DELIVERY
  INSTALLATION

  COMPLETED
  CANCELLED
}

model CapacityLot {
  id    String        @id @default(uuid())
  stage CapacityStage @unique

  // default stage duration capacity
  days     Int
  capacity Int?

  // total working hours per day
  // MORNING   => 2:30 - 6:30
  // AFTERNOON => 7:30 - 11:00
  // FULL_DAY  => both shifts
  workingHours Float @default(7.5)
 // NEW: allows scheduler to auto-balance workload
  parallelSlots Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("capacity_lots")
  capacityLotHistories CapacityLotHistory[]
}
model CapacityLotHistory {
  id String @id @default(uuid())

  capacityLotId String
  capacityLot   CapacityLot @relation(fields: [capacityLotId], references: [id], onDelete: Cascade)

  stage CapacityStage

  oldDays Int?
  newDays Int?

  oldCapacity Int?
  newCapacity Int?

  action CapacityHistoryAction

  changedById String?
  changedBy   User? @relation(fields: [changedById], references: [id])

  createdAt DateTime @default(now())

  @@index([capacityLotId])
  @@index([createdAt])
}

enum CapacityHistoryAction {
  CREATED
  UPDATED
}
model DailyStageCapacity {
  id    String        @id @default(uuid())
  stage CapacityStage

  // specific working date
  date DateTime

  // allocated unit capacity (Float: the hours-based scheduler produces
  // fractional per-day units, e.g. 1.5 units in a partial/overcapacity day —
  // Int rounding caused counter↔allocation drift and false >125% violations)
  usedCapacity Float @default(0)
  maxCapacity  Float

  // daily working hours
  workingHours Float @default(7.5)

  // used/remaining hours tracking
  usedHours Float @default(0)
  maxHours  Float

  // shift tracking
  // MORNING   => 2:30 - 6:30
  // AFTERNOON => 7:30 - 11:00
  // FULL_DAY  => both shifts
  // CUSTOM    => any custom range like 2:30 - 3:00
  shift WorkShift @default(FULL_DAY)

  // used only when shift = CUSTOM
  customStartTime DateTime?
  customEndTime   DateTime?

  // over-capacity support for urgent tasks
  overCapacityUsed      Float @default(0)
  overHoursCapacityUsed Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stage, date])

  @@map("daily_stage_capacities")

  projectStageCapacityAllocations ProjectStageCapacityAllocation[]
}

model ProjectStage {
  id        String   @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  stage        ProjectStatus
  capacityDays Int
  workUnits    Float?

  finished Boolean @default(false)

  startDate DateTime
  endDate   DateTime

  // MORNING   => 2:30 - 6:30
  // AFTERNOON => 7:30 - 11:00
  // FULL_DAY  => both shifts
  // CUSTOM    => any custom range like 2:30 - 3:00
  startDateTime  DateTime
    endDateTime  DateTime

  shift WorkShift? @default(FULL_DAY)
  timeTaken Int?
  // used only when allways add this
  customStartTime DateTime?
  customEndTime   DateTime?

  actualWorkUnits Float?

  autoSchedule Boolean     @default(true)
  status       StageStatus @default(ACTIVE)

  @@map("project_stages")

  projectStageWorkLogs            ProjectStageWorkLog[]
  projectStageCapacityAllocations ProjectStageCapacityAllocation[]
}

model ProjectStageCapacityAllocation {
  id String @id @default(uuid())

  // project stage
  projectStageId String
  projectStage   ProjectStage @relation(fields: [projectStageId], references: [id], onDelete: Cascade)

  // daily capacity
  dailyStageCapacityId String
  dailyStageCapacity   DailyStageCapacity @relation(fields: [dailyStageCapacityId], references: [id], onDelete: Cascade)

  // allocation details (Float units — match the daily counter so a day's
  // usedCapacity always equals the sum of its allocation rows)
  allocatedUnits Float
  allocatedHours Float

  // allocated shift
  shift WorkShift @default(FULL_DAY)
  startDateTime  DateTime
    endDateTime  DateTime

  // used only when allways add this
  customStartTime DateTime?
  customEndTime   DateTime?

  isOverCapacity Boolean @default(false)

  allocationDate DateTime

  createdAt DateTime @default(now())

  @@index([projectStageId])
  @@index([dailyStageCapacityId])

  @@map("project_stage_capacity_allocations")
}

