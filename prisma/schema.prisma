    designStatus               DesignStatus? 
  designFinished         DateTime?

  
  designById           String?   @db.Char(36)
  designBy             User?     @relation("designproject", fields: [designById], references: [id])


  status               ProjectStatus?
  difficulty            DifficultyLevel @default(EASY)

  // Governs whether automatic jobs (nightly cron, completion-cascade,
  // auto-schedule) may move this project's dates. See ScheduleMode.
  scheduleMode         ScheduleMode @default(AUTO)

  requestedDelivery    DateTime?
  calculatedDelivery   DateTime?
  manualDelivery   DateTime?

  finalDelivery    DateTime?
   totalFinishedPercent Int @default(0)
  totalDays            Int?
 totalProjectQuantity          Int?
  completedAt          DateTime?
  cancelledAt          DateTime?
