generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"

    url      = env("DATABASE_URL")

}
enum Status {
  Active
  Inactive
  Suspended
}

model User {
  id          String      @id @default(uuid()) @map("_id") @db.Char(36)
  name        String       @map("name")
  phone       String?     @map("phone")
  userCode    String? 
  email       String      @unique
  admin       Boolean     @default(false)
  password    String
  roleId      String      @db.Char(36)
  role        Role        @relation(fields: [roleId], references: [id])
  status      Status      @default(Active) 

   // ✅ A user can be assigned to many showrooms
  showrooms       Showroom[]   @relation("UserShowrooms")

  // ✅ A user can be assigned to many stores
  stores      Store[]  @relation("UserStores") 

    // <-- Enum status field replacing isActive
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
lastLoginAt DateTime?    @default(now())
  @@map("users")
Log Log[]

purchases Purchase[] @relation(name: "creator")
uppurchases Purchase[] @relation("UpdatedCheckEntrance")
proformaInvoices ProformaInvoice[] @relation(name: "creator")
projects Project[] @relation(name: "creator")
updateprojects Project[] @relation("Updatedproject")
approveproformaInvoices ProformaInvoice[] @relation(name: "approver")
deliveryEstimations DeliveryEstimation[] @relation(name: "creator")
updatedeliveryEstimations DeliveryEstimation[] @relation("Updatedproject")
projectStageWorkLogs ProjectStageWorkLog[]
creatorproformaInvoiceBanks ProformaInvoiceBank[] @relation(name: "creator")
stockLedgers StockLedger[]
stockCorrections StockCorrection[] @relation("createdStockCorrection")
updatedstockCorrections StockCorrection[] @relation("updatedStockCorrection")
materialIssues MaterialIssue[] @relation("IssuedByUser")
givenmaterialIssues MaterialIssue[] @relation("GivenToUser")
projectLogs ProjectLog[]
designbyprojects Project[] @relation("designproject")
itemStockLedgers ItemStockLedger[]
sellPayments SellPayment[]
sells Sell[] @relation("CreatedSale")
updaatesells Sell[] @relation("UpdatedSale")
transfers Transfer[] @relation("createdTransfer")
updatetransfers Transfer[] @relation("UpdatedTransfer")
scheduleHistories ScheduleHistory[]
piLogs PiLog[]
capacityLotHistories CapacityLotHistory[]
}

model Role {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  name        String           @unique @db.VarChar(100)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  name        String           @unique @db.VarChar(100)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  roleId       String      @db.Char(36)
  permissionId String      @db.Char(36)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}


model Company {
  id          String       @id @default(uuid()) @map("_id") @db.Char(36)
  name        String
  email       String?      @unique
  phone       String?
  address String? // Optional field
  addressTow   String?
  tiktok String?

  description String?
  tinAddress String? 
  TIN String? 
  From String? 
  logo String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("companies")
}




model Log {
  id        String      @id @default(uuid()) @map("_id") @db.Char(36)
  action    String          @db.VarChar(1000)                    // e.g., "Added 50", "Transferred 20", "Sold 5"
  userId    String?      @db.Char(36)
  user      User?        @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("stock_logs")
}

model Customer {
  id         String   @id @default(uuid()) @map("_id") @db.Char(36)
  name       String   @map("first_name")
    companyName   String?         @db.VarChar(255)
    isdefault Boolean   @default(true)
  phone1     String   @map("phone1")
  phone2     String?  @map("phone2")   // optional second phone
  tinNumber  String?  @db.VarChar(100)
  address    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  email         String?  @db.VarChar(255) // optional email

  @@map("customers")
 
  proformaInvoices ProformaInvoice[]
  projects Project[]
  sells Sell[]
}



model Supplier {
  id            String          @id @default(uuid()) @map("_id")  @db.Char(36)
  name          String          @db.VarChar(255)
  contactName   String?         @db.VarChar(255)
  phone         String?         @db.VarChar(50)
  email         String?         @db.VarChar(255)
  address       String?
  city          String?         @db.VarChar(100)
  country       String?         @db.VarChar(100)
  tinNumber     String?         @db.VarChar(100)
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("suppliers")
  Purchase Purchase[]
}
model Bank {
  id            String   @id @default(uuid())
  bankName      String
  accountNumber String   @unique

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("banks")
  purchases Purchase[]
  proformaInvoiceBanks ProformaInvoiceBank[]
  sellPayments SellPayment[]
}

model UnitOfMeasure {
  id       String     @id @default(uuid()) @map("_id") @db.Char(36)
  name     String     @unique
  symbol   String?
    base     Boolean    @default(false)

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("units_of_measure")
  stockLedgers StockLedger[]
  materials Material[]
  purchaseItems PurchaseItem[]
}
model Showroom {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  name        String
  isMain      Boolean  @default(false) @unique

  inventoryStocks InventoryStock[]

  itemStocks ItemStock[]


  stockCorrections StockCorrection[]

  itemStockLedgers ItemStockLedger[]

  stockLedgers StockLedger[]

  transfers Transfer[] @relation("TransferSourceShowroom")

  distnationtransfers Transfer[] @relation("TransferDestinationShowroom")


  users User[] @relation("UserShowrooms")
}
model Store {
  id          String @id @default(uuid()) @map("_id") @db.Char(36)
  name        String
  isMain      Boolean  @default(false) @unique

  inventoryStocks InventoryStock[]

  itemStocks ItemStock[]

  purchases Purchase[]


  stockCorrections StockCorrection[]

  itemStockLedgers ItemStockLedger[]

  stockLedgers StockLedger[]

  sells Sell[]

  transfers Transfer[] @relation("TransferSourceStore")

  distnationtransfers Transfer[] @relation("TransferDestinationStore")


  users User[] @relation("UserStores")
}
enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RETURN
  DAMAGE
  EXPIRE
}
model StockLedger {
  id               String            @id @default(uuid()) @map("_id")  @db.Char(36)
  movementType     StockMovementType
  quantity         Int

  // 🔗 Material Relation
  materialId       String          
  material         Material          @relation(fields: [materialId], references: [id])
  storeId     String?
  store       Store?        @relation(fields: [storeId], references: [id])

  showroomId  String?
  showroom    Showroom?     @relation(fields: [showroomId], references: [id])
  
  // 🔗 Unit Relation
  unitId           String?         
  unit             UnitOfMeasure?    @relation(fields: [unitId], references: [id])

  reference        String?
  movementDate     DateTime          @default(now())

  userId           String?         
  user             User?             @relation(fields: [userId], references: [id], map: "fk_stockledger_user")  // ← Added custom name

  notes            String?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
 
  @@map("stockledger")
}


model InventoryStock {
  id          String       @id @default(uuid()) @map("_id") @db.Char(36)

  // 🔗 Material Relation
  materialId  String        
  material    Material      @relation(fields: [materialId], references: [id])

  quantity    Int
  status      StockStatus   @default(Available)

    // 📍 Location
  storeId     String?
  store       Store?        @relation(fields: [storeId], references: [id])

  showroomId  String?
  showroom    Showroom?     @relation(fields: [showroomId], references: [id])

  lastUpdated DateTime      @default(now()) @map("last_updated")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([materialId, storeId, showroomId]) 
  @@map("inventorystocks")
}


enum StockStatus {
  Available
  In_Use
  Reserved
  Broken
  Lost
  Disposed
  Expired
  DAMAGED
  Sold  // Add this value
}


model MaterialCategory {
  id            String   @id @default(uuid())
  name          String

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  @@map("categories") // Add this line if your table is actually called 'categories'
  materials Material[]
}
model Material {
  id        String   @id @default(uuid())
  name      String
  color     String?
  size      String?
  plainMDF Boolean?
  laminatedMDF Boolean?
  wood  Boolean?
  metal  Boolean?
  accessory    Boolean?   // ✅ New
  other        Boolean?   // ✅ New
  imageUrl      String?
  warningStockLevel Int?    @default(10) // ✅ New field for warning level
  // 🔗 Relation to MaterialType
    // 🔗 Relation to Unit Of Measure
  unitOfMeasureId String?
  unitOfMeasure   UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])


materialTypeId String
materialType   MaterialCategory @relation(fields: [materialTypeId], references: [id])

  items     ProformaItemMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("materials")
  purchaseItems PurchaseItem[]
  itemMaterials ItemMaterial[]
  stockLedgers StockLedger[]
  inventoryStocks InventoryStock[]
  stockCorrectionItems StockCorrectionItem[]
  transferItems TransferItem[]
}
model Purchase {
  id             String           @id @default(uuid()) @map("_id") @db.Char(36)
  invoiceNo      String           @unique                      // Invoice number
  supplierId     String           @db.Char(36)
  supplier       Supplier         @relation(fields: [supplierId], references: [id])
bankId String? @db.Char(36)
bank   Bank?   @relation(fields: [bankId], references: [id])

storeId        String           @db.Char(36)
  store          Store            @relation(fields: [storeId], references: [id])

  paymentStatus  PaymentStatus    @default(PENDING)               // Paid, Pending, Partial, Unpaid

  totalProducts  Int              @default(0)                  // number of different items
  subTotal       Float            @default(0)
  grandTotal     Float            @default(0)

  notes          String?
  purchaseDate   DateTime         @default(now())
  
  createdBy User?          @relation(fields: [createdById], references: [id], name: "creator")
  createdById          String?        @db.Char(36)
   updatedById           String?   @db.Char(36)
updatedBy             User?     @relation("UpdatedCheckEntrance", fields: [updatedById], references: [id])


  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  items          PurchaseItem[]

  @@map("purchases")
  stockCorrections StockCorrection[]
}
model PurchaseItem {
  id          String             @id @default(uuid()) @map("_id") @db.Char(36)
  purchaseId  String          @db.Char(36)
  purchase    Purchase        @relation(fields: [purchaseId], references: [id])

  materialId  String
  material    Material @relation(fields: [materialId], references: [id])

  unitOfMeasureId String?
  unitOfMeasure   UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id])

  // ✅ Link directly to a single unit of measure\
  quantity    Int
  unitPrice   Float           @default(0)
  totalPrice  Float           @default(0)

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("purchase_items")
}
model ItemMaterial {
  id String @id @default(uuid())

  // 🔗 Item relation
  itemId String
  item   Items @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // 🔗 Material relation
  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  quantity Int
  note     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // prevent same material twice for one item
  @@unique([itemId, materialId])

  @@map("item_materials")
}
model ProductCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  items Items[]

  sizes Size[]
}
model Size {
  id        String   @id @default(uuid())
  name      String   // e.g. Small, Medium, Large OR numeric like 40, 41
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id]) // 👈 relation


  items Items[]

  productTypes ProductType[]
}
model ProductType {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sizeId    String?
  size      Size?     @relation(fields: [sizeId], references: [id]) // 👈 Type belongs to Size



  items Items[]
}

model Items {
  id        String   @id @default(uuid())
  name      String
  price    Int              @default(0)  
  imageUrl      String?
  color    String?          
                 // Relations
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  typeId     String?
  type       ProductType? @relation(fields: [typeId], references: [id])

  sizeId     String?
  size       Size? @relation(fields: [sizeId], references: [id])

 test Boolean? @default(false) // Add this field to indicate if the item is a test item
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("items")
  itemMaterials ItemMaterial[]
  itemStocks ItemStock[]
  itemStockLedgers ItemStockLedger[]
  proformaInvoiceItems ProformaInvoiceItem[]
  sellItems SellItem[]
  transferItems TransferItem[]
  stockCorrectionItems StockCorrectionItem[]
  itemImages ItemImage[]
}

model ItemImage {
  id        String   @id @default(uuid())

  imageUrl  String

  itemId    String
  item      Items    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("item_images")
}
model ItemStock {
  id        String   @id @default(uuid())

  itemId    String
  item      Items    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  quantity  Int

  // 📍 Location
  storeId     String?
  store       Store?        @relation(fields: [storeId], references: [id])

  showroomId  String?
  showroom    Showroom?     @relation(fields: [showroomId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, storeId, showroomId])
  @@map("item_stocks")
}

model ItemStockLedger {
  id            String   @id @default(uuid())

  itemId        String
  item          Items    @relation(fields: [itemId], references: [id])

  movementType  StockMovementType
  quantity      Int

  reference     String?
  notes         String?

  storeId     String?
  store       Store?        @relation(fields: [storeId], references: [id])

  showroomId  String?
  showroom    Showroom?     @relation(fields: [showroomId], references: [id])
  userId        String?
  user          User? @relation(fields: [userId], references: [id])

  createdAt     DateTime @default(now())
}

enum SaleStatus {
  NOT_APPROVED
  PARTIALLY_DELIVERED
  APPROVED
  DELIVERED
  CANCELLED
}
enum SellPaymentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
  NONE
}
model SellPayment {
  id String @id @default(uuid()) @map("_id") @db.Char(36)

  sellId String @db.Char(36)
  sell   Sell   @relation(fields: [sellId], references: [id])

  amount      Float
  createdById String? @db.Char(36)
  createdBy   User?   @relation(fields: [createdById], references: [id])

  bankId             String
  bank               Bank @relation(fields: [bankId], references: [id])

  paidBy String? 



  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sell_payments")
}
model Sell {
  id            String            @id @default(uuid()) @map("_id") @db.Char(36)
  invoiceNo     String            @unique

    imageUrl      String?
  documentUrl   String?
  
  paymentStatus SellPaymentStatus @default(PENDING) // Paid, Pending, Partial, Unpaid
  grandTotal    Float             @default(0)
  balance       Int               @default(0)
  totalPaid     Int               @default(0)
storeId        String           @db.Char(36)
  store          Store            @relation(fields: [storeId], references: [id])

  saleStatus SaleStatus @default(NOT_APPROVED)
  locked     Boolean    @default(false)
  lockedAt   DateTime?

  customerId String?   @db.Char(36)
  customer   Customer? @relation(fields: [customerId], references: [id])

  totalProducts Int   @default(0)
  subTotal      Float @default(0)
  discount      Float @default(0)
  vat           Float @default(0)

  notes    String?
  saleDate DateTime @default(now())


  createdById String? @db.Char(36)
  createdBy   User?   @relation("CreatedSale", fields: [createdById], references: [id])
  updatedById String? @db.Char(36)
  updatedBy   User?   @relation("UpdatedSale", fields: [updatedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items               SellItem[]
  sellPayments        SellPayment[]

  @@map("sells")
}
model SellItem {
  id     String @id @default(uuid()) @map("_id") @db.Char(36)
  sellId String @db.Char(36)
  sell   Sell   @relation(fields: [sellId], references: [id])

  itemId String @db.Char(36)
  item   Items  @relation(fields: [itemId], references: [id])

  itemSaleStatus    ItemSaleStatus @default(PENDING)

  quantity Int

  unitPrice  Float @default(0)
  totalPrice Float @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sell_items")
}   
enum ItemSaleStatus {
  PENDING
  DELIVERED
  REJECTED
  PARTIALLY_DELIVERED
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}
enum TransferEntityType {
  STORE
  SHOWROOM
}
model Transfer {
  id              String           @id @default(uuid()) @map("_id") @db.Char(36)
  shortCode      String          @unique                 // Invoice number

  // Source
  sourceType      TransferEntityType
  sourceStoreId   String? @db.Char(36)
  sourceStore     Store?  @relation("TransferSourceStore", fields: [sourceStoreId], references: [id])
  sourceShowroomId    String? @db.Char(36)
  sourceShowroom      Showroom?   @relation("TransferSourceShowroom", fields: [sourceShowroomId], references: [id])

  // Destination
  destinationType TransferEntityType
  destStoreId     String? @db.Char(36)
  destStore       Store?  @relation("TransferDestinationStore", fields: [destStoreId], references: [id])
  destShowroomId      String? @db.Char(36)
  destShowroom        Showroom?   @relation("TransferDestinationShowroom", fields: [destShowroomId], references: [id])

  // Transfer details
  reference       String?       // optional transfer reference code
  notes           String?
  status          TransferStatus @default(PENDING)
  movementDate    DateTime @default(now())

  createdById     String? @db.Char(36)
  createdBy       User?   @relation("createdTransfer",fields: [createdById], references: [id])
updatedById           String?   @db.Char(36)
updatedBy             User?     @relation("UpdatedTransfer", fields: [updatedById], references: [id])

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  items           TransferItem[]
  
  @@map("transfers")
}
model TransferItem {
  id            String        @id @default(uuid()) @map("_id") @db.Char(36)
  transferId    String        @db.Char(36)
  transfer      Transfer      @relation(fields: [transferId], references: [id])

  ismaterial      Boolean       @default(false) // true if material, false if item

itemId String? @db.Char(36)
  item   Items?  @relation(fields: [itemId], references: [id])

    materialId  String?
  material    Material? @relation(fields: [materialId], references: [id])


  quantity      Int

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("transfer_items")
}
model ProformaInvoiceBank {
  id                 String   @id @default(uuid())

  proformaInvoiceId  String
  proformaInvoice    ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id])

  bankId             String
  bank               Bank @relation(fields: [bankId], references: [id])

  paidBy String? 

  createdBy User?          @relation(fields: [createdById], references: [id], name: "creator")
  createdById          String?        @db.Char(36)
  amount             Float?
  createdAt          DateTime @default(now())

  @@map("proforma_invoice_banks")
}

model ProformaInvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     ProformaInvoice @relation(fields: [invoiceId], references: [id])

  description String  @db.Text 
  size        String?
  quantity    Int
  unitPrice   Float
  amount      Float

    itemId      String?  // Add this field
  item        Items?   @relation(fields: [itemId], references: [id]) // Add this relation

  additionalDescription String? @db.Text  // Also change this if it has long content
  images ProformaInvoiceItemImage[]

  @@map("proforma_invoice_items")
  proformaItemMaterials ProformaItemMaterial[]
}

model PiLog {
  id        String      @id @default(uuid()) @map("_id") @db.Char(36)
  action    String          @db.VarChar(1000)                    // e.g., "Added 50", "Transferred 20", "Sold 5"
  piuserId    String?      @db.Char(36)
  piuser      User?        @relation(fields: [piuserId], references: [id])

  proformaId String @db.Char(36)
  proforma   ProformaInvoice @relation(fields: [proformaId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pi_logs")
}
model ProformaInvoice {
  id          String   @id @default(uuid())
  piNumber    String   @unique
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
    paymentStatus SellPaymentStatus @default(PENDING) // Paid, Pending, Partial, Unpaid

  store       Boolean @default(false)
  status      PIStatus
  subtotal    Float
  vat         Float?  @default(0)
  total       Float

  amountPaid  Float    @default(0)
  balance     Float
  amountDate   DateTime?

  preparedBy User?          @relation(fields: [preparedById], references: [id], name: "creator")
  preparedById          String?        @db.Char(36)
    approvedBy User?          @relation(fields: [approvedById], references: [id], name: "approver")
 approvedById          String?        @db.Char(36)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       ProformaInvoiceItem[]

    banks       ProformaInvoiceBank[]

  attachments Attachment[]
  project     Project?

  @@map("proforma_invoices")
  piLogs PiLog[]
}
model ProformaItemMaterial {
  id          String @id @default(uuid())

  itemId      String
  item        ProformaInvoiceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  materialId  String
  material    Material @relation(fields: [materialId], references: [id])

  quantity    Int
    additionalQuantity Int? @default(0)
      givenquantity Int? @default(0)

     // 👈 quantity of this material for this item
  note        String? @db.Text

    status      MaterialIssueStatus @default(PENDING) // 👈 Added Status





  issuedAt    DateTime? // 👈 when issued

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  materials   ProformaItemMaterial[] @relation("ProformaItemMaterialToMaterial")  // 👈 one item → many materials

  @@unique([itemId, materialId]) // prevent duplicate material per item
  @@map("proforma_item_materials")
