# ==========================================
# Mezidwood Backend — Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ------------------------------------------
# App
# ------------------------------------------
NODE_ENV=development
PORT=5000

# ------------------------------------------
# Database (MySQL — used by Prisma)
# ------------------------------------------
DATABASE_URL=mysql://root:@localhost:3306/mezidwood

# ------------------------------------------
# JWT Authentication
# ------------------------------------------
JWT_SECRET=your-jwt-secret-at-least-16-chars
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=1

# ------------------------------------------
# Admin Seed (initial setup)
# ------------------------------------------
ADMIN_PASSWORD=Admin@1234

# ------------------------------------------
# Email (Nodemailer)
# ------------------------------------------
EMAIL=your-email@example.com
EMAIL_PASSWORD=your-email-app-password

# ------------------------------------------
# CORS
# ------------------------------------------
# Comma-separated origins, e.g. http://localhost:3030,https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3030

# ------------------------------------------
# Rate Limiting
# ------------------------------------------
MAX_ATTEMPTS_PER_DAY=100
MAX_ATTEMPTS_BY_IP_USERNAME=10
MAX_ATTEMPTS_PER_EMAIL=5

# ------------------------------------------
# Proxy
# ------------------------------------------
TRUST_PROXY=false

# ------------------------------------------
# Storage (optional — for S3 uploads)
# ------------------------------------------
# STORAGE_PROVIDER=local
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=your-bucket-name
